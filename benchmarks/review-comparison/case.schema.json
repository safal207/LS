{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/LS/benchmarks/review-comparison/case.schema.json",
  "title": "LS Blind Review Benchmark Case v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "status",
    "evidence_manifest_path",
    "evidence_sha256",
    "coordinates",
    "prompt_path",
    "lanes"
  ],
  "properties": {
    "schema_version": {
      "const": "ls.review_benchmark_case.v0.1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PREPARED",
        "FROZEN"
      ]
    },
    "evidence_manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "evidence_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pr_number",
        "base_sha",
        "head_sha",
        "changed_file_count"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "changed_file_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "prompt_path": {
      "type": "string",
      "minLength": 1
    },
    "lanes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane",
          "visibility",
          "must_not_receive"
        ],
        "properties": {
          "lane": {
            "enum": [
              "CLAUDE",
              "LS"
            ]
          },
          "visibility": {
            "const": "FROZEN_BUNDLE_ONLY"
          },
          "must_not_receive": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PREPARED"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FROZEN"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
