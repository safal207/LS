{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LS Portable Authorization Bundle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "adapter",
    "actor",
    "created_at",
    "expires_at",
    "intent_ref",
    "decision_ref",
    "authorization_ref",
    "task_id",
    "trail_id",
    "action_ref",
    "candidate_digest",
    "intent_digest",
    "target_state_digest",
    "policy_id",
    "policy_version",
    "nonce",
    "scope",
    "evidence_refs",
    "evidence_snapshot_digest",
    "causal_audit_refs",
    "chain_head",
    "file_hashes",
    "file_names",
    "verification_instructions",
    "commit_before_effect_eligible",
    "execution_authorized"
  ],
  "properties": {
    "schema_version": {"const": "ls.authorization_bundle.v0.1"},
    "bundle_id": {"type": "string", "pattern": "^ls-bundle-[0-9a-f]{20}$"},
    "adapter": {"const": "ls-proofpath-style"},
    "actor": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "intent_ref": {"type": "string", "minLength": 1},
    "decision_ref": {"type": "string", "minLength": 1},
    "authorization_ref": {"type": "string", "pattern": "^authorization-record:sha256:[0-9a-f]{64}$"},
    "task_id": {"type": "string", "minLength": 1},
    "trail_id": {"type": "string", "minLength": 1},
    "action_ref": {"type": "string", "minLength": 1},
    "candidate_digest": {"type": "string", "minLength": 1},
    "intent_digest": {"type": "string", "minLength": 1},
    "target_state_digest": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "nonce": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_snapshot_digest": {"type": "string", "minLength": 1},
    "causal_audit_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "chain_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_hashes": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "file_names": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verification_instructions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "commit_before_effect_eligible": {"const": true},
    "execution_authorized": {"const": false}
  }
}
