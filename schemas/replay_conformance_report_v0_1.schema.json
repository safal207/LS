{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LS Replay Conformance Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trail_id",
    "classification",
    "reason_code",
    "completion_state",
    "integrity_valid",
    "valid_prefix_events",
    "parsed_events",
    "chain_head",
    "checkpoint_ref",
    "resume_allowed",
    "append_outcome",
    "persisted_events",
    "redactions_applied",
    "privacy_status",
    "model_calls",
    "tool_calls",
    "effect_calls",
    "report_ref"
  ],
  "properties": {
    "schema_version": {"const": "ls.replay_conformance_report.v0.1"},
    "trail_id": {"type": "string", "minLength": 1},
    "classification": {"enum": ["ADMISSIBLE", "DRIFTED", "REJECTED"]},
    "reason_code": {"type": "string", "minLength": 1},
    "completion_state": {"enum": ["COMPLETE", "PARTIAL", "INVALID"]},
    "integrity_valid": {"type": "boolean"},
    "valid_prefix_events": {"type": "integer", "minimum": 0},
    "parsed_events": {"type": "integer", "minimum": 0},
    "chain_head": {"type": ["string", "null"]},
    "checkpoint_ref": {"type": ["string", "null"]},
    "resume_allowed": {"type": "boolean"},
    "append_outcome": {"enum": ["APPENDED", "IDEMPOTENT", "CONFLICT"]},
    "persisted_events": {"type": "integer", "minimum": 0},
    "redactions_applied": {"type": "integer", "minimum": 0},
    "privacy_status": {"enum": ["pass", "fail"]},
    "model_calls": {"const": 0},
    "tool_calls": {"const": 0},
    "effect_calls": {"const": 0},
    "report_ref": {"type": "string", "pattern": "^replay-report:[0-9a-f]{64}$"}
  }
}
