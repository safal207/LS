{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/LS/schemas/outcome-verification-v0.1.schema.json",
  "title": "LS Outcome Verification Input v0.1",
  "type": "object",
  "required": [
    "verification_version",
    "execution_identity",
    "expected_outcome",
    "evidence_contract",
    "execution_receipt",
    "observations",
    "provenance"
  ],
  "properties": {
    "verification_version": {
      "const": "outcome-verification-v0.1"
    },
    "execution_identity": {
      "type": "object",
      "required": [
        "execution_id",
        "action_id",
        "action_digest",
        "actor_id",
        "target_id",
        "side_effect_key"
      ],
      "properties": {
        "execution_id": {"type": "string", "minLength": 1},
        "action_id": {"type": "string", "minLength": 1},
        "action_digest": {"type": "string", "minLength": 1},
        "actor_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "side_effect_key": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "expected_outcome": {
      "type": "object",
      "required": [
        "pre_state_digest",
        "expected_state_digest",
        "consistency_window_until",
        "verification_deadline_at"
      ],
      "properties": {
        "pre_state_digest": {"type": "string", "minLength": 1},
        "expected_state_digest": {"type": "string", "minLength": 1},
        "consistency_window_until": {"type": "string", "format": "date-time"},
        "verification_deadline_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "evidence_contract": {
      "type": "object",
      "required": [
        "required_evidence_kinds",
        "min_independent_observers",
        "required_observer_scope_digest",
        "allow_receipt_only"
      ],
      "properties": {
        "required_evidence_kinds": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "min_independent_observers": {"type": "integer", "minimum": 1},
        "required_observer_scope_digest": {"type": "string", "minLength": 1},
        "allow_receipt_only": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "execution_receipt": {
      "type": "object",
      "required": [
        "receipt_id",
        "receipt_digest",
        "execution_id",
        "action_id",
        "action_digest",
        "side_effect_key",
        "status",
        "issued_at",
        "issuer_id"
      ],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "receipt_digest": {"type": "string", "minLength": 1},
        "execution_id": {"type": "string", "minLength": 1},
        "action_id": {"type": "string", "minLength": 1},
        "action_digest": {"type": "string", "minLength": 1},
        "side_effect_key": {"type": "string", "minLength": 1},
        "status": {"enum": ["accepted", "completed", "failed", "unknown"]},
        "issued_at": {"type": "string", "format": "date-time"},
        "issuer_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "observer_id",
          "observer_type",
          "independent",
          "authority_scope_digest",
          "observed_at",
          "state_digest",
          "evidence_kind",
          "evidence_digest",
          "outcome_status"
        ],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "observer_id": {"type": "string", "minLength": 1},
          "observer_type": {"enum": ["runtime", "state_store", "human", "external_system"]},
          "independent": {"type": "boolean"},
          "authority_scope_digest": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "format": "date-time"},
          "state_digest": {"type": ["string", "null"]},
          "evidence_kind": {"type": "string", "minLength": 1},
          "evidence_digest": {"type": "string", "minLength": 1},
          "outcome_status": {"enum": ["complete", "partial", "absent"]}
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": ["causal_trace_id", "source_event_ids"],
      "properties": {
        "causal_trace_id": {"type": "string", "minLength": 1},
        "source_event_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
