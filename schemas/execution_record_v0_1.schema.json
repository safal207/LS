{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LS Commit-Before-Effect Execution Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "task_id",
    "trail_id",
    "action_id",
    "action_ref",
    "action_digest",
    "authorization_ref",
    "authorization_nonce",
    "verifier_result_ref",
    "state",
    "decision_code",
    "actor",
    "created_at",
    "updated_at",
    "committed_at",
    "executed_at",
    "effect_ref",
    "effect_attempted",
    "effect_succeeded",
    "execution_authorized",
    "transitions",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "ls.execution_record.v0.1"},
    "execution_id": {"type": "string", "pattern": "^execution:sha256:[0-9a-f]{64}$"},
    "task_id": {"type": "string", "minLength": 1},
    "trail_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "action_ref": {"type": "string", "minLength": 1},
    "action_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_ref": {"type": "string", "minLength": 1},
    "authorization_nonce": {"type": "string", "minLength": 1},
    "verifier_result_ref": {"type": "string", "minLength": 1},
    "state": {"enum": ["RECEIVED", "VALIDATING", "HELD", "ACCEPTED", "COMMITTED", "EXECUTED", "REJECTED", "EXPIRED"]},
    "decision_code": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "committed_at": {"type": ["string", "null"], "format": "date-time"},
    "executed_at": {"type": ["string", "null"], "format": "date-time"},
    "effect_ref": {"type": ["string", "null"]},
    "effect_attempted": {"type": "boolean"},
    "effect_succeeded": {"type": ["boolean", "null"]},
    "execution_authorized": {"type": "boolean"},
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "state", "decision_code", "created_at", "detail", "effect_attempted"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "state": {"enum": ["RECEIVED", "VALIDATING", "HELD", "ACCEPTED", "COMMITTED", "EXECUTED", "REJECTED", "EXPIRED"]},
          "decision_code": {"type": "string", "minLength": 1},
          "created_at": {"type": "string", "format": "date-time"},
          "detail": {"type": "string", "minLength": 1},
          "effect_attempted": {"type": "boolean"}
        }
      }
    },
    "error": {"type": ["string", "null"]}
  }
}
