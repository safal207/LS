{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LS Trusted Runtime Cognitive Trail",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "trail_id",
    "actor",
    "created_at",
    "events"
  ],
  "properties": {
    "schema_version": {"const": "trusted_runtime.cognitive_trail.v0.1"},
    "task_id": {"type": "string", "minLength": 1},
    "trail_id": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/trailEvent"}
    }
  },
  "$defs": {
    "trailEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "task_id",
        "trail_id",
        "event_type",
        "actor",
        "created_at",
        "parent_cause",
        "evidence_refs",
        "payload"
      ],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "trail_id": {"type": "string", "minLength": 1},
        "event_type": {
          "enum": [
            "TASK_RECEIVED",
            "PLAN_CREATED",
            "PLAN_REVISED",
            "ROUTE_SELECTED",
            "WORK_COMPLETED",
            "CAUSAL_AUDIT",
            "EVIDENCE_DECISION",
            "AUTHORIZATION_ISSUED",
            "EXECUTION_COMMITTED",
            "EXECUTION_COMPLETED",
            "REPLAY_CHECKED",
            "ARTIFACT_CREATED"
          ]
        },
        "actor": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "parent_cause": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "payload": {"type": "object"}
      }
    }
  }
}
