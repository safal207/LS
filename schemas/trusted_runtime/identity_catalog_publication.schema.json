{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LS Atomic Identity Catalog Publication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation",
    "published_at",
    "audience",
    "active_key_id",
    "accepted_key_ids",
    "previous_publication_digest",
    "source_fingerprint",
    "entries",
    "legacy_catalog",
    "policy_version",
    "signatures",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": "trusted_runtime.identity_catalog_publication.v0.1"},
    "generation": {"type": "integer", "minimum": 1},
    "published_at": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "active_key_id": {"type": "string", "minLength": 1},
    "accepted_key_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "previous_publication_digest": {"type": ["string", "null"]},
    "source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "bundle_path",
          "timeline_digest",
          "tail_event_ref",
          "event_count",
          "active_profile_version",
          "lifecycle_status",
          "freshness_at",
          "visibility",
          "health",
          "authoritative",
          "findings"
        ],
        "properties": {
          "agent_id": {"type": "string", "minLength": 1},
          "bundle_path": {"type": "string", "minLength": 1},
          "timeline_digest": {"type": ["string", "null"]},
          "tail_event_ref": {"type": ["string", "null"]},
          "event_count": {"type": "integer", "minimum": 0},
          "active_profile_version": {"type": ["integer", "null"], "minimum": 1},
          "lifecycle_status": {"type": "string", "minLength": 1},
          "freshness_at": {"type": ["string", "null"]},
          "visibility": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "health": {"enum": ["VALID", "STALE", "INVALID"]},
          "authoritative": {"type": "boolean"},
          "findings": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "legacy_catalog": {"type": "object"},
    "policy_version": {"const": "identity_catalog.publisher.v0.1"},
    "signatures": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "publication_digest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "publication_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
