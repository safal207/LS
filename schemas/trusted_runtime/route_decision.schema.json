{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LS Trusted Runtime Route Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_id",
    "task_id",
    "trail_id",
    "role_id",
    "capability",
    "adapter",
    "actor",
    "selected_backend",
    "considered_backends",
    "reason",
    "created_at",
    "parent_cause",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": "trusted_runtime.route_decision.v0.1"},
    "route_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "trail_id": {"type": "string", "minLength": 1},
    "role_id": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "adapter": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "selected_backend": {"type": "string", "minLength": 1},
    "considered_backends": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "reason": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "parent_cause": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"}
  }
}
