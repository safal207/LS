{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LS Agent Orientation Context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "orientation_id", "transition_id", "task_id", "trail_id", "actor", "intent", "created_at", "stage", "role_ids", "route_refs", "evidence_refs", "causal_parent_refs", "dimensions", "actual_state", "expected_state", "forbidden_deltas", "constraints", "decision", "decision_reason", "authorization_ref", "execution_ref", "effect_ref", "replay_ref", "artifact_ref", "metadata"],
  "properties": {
    "schema_version": {"const": "trusted_runtime.orientation_context.v0.1"},
    "orientation_id": {"type": "string", "minLength": 1},
    "transition_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "trail_id": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "stage": {"enum": ["PROPOSED", "PLANNED", "ROUTED", "CAUSALLY_AUDITED", "EVIDENCE_DECIDED", "AUTHORIZED", "COMMITTED", "EXECUTED", "HELD", "BLOCKED", "ESCALATED", "REPLAYABLE"]},
    "role_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "route_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "causal_parent_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "dimensions": {"type": "object", "required": ["intent", "authority", "evidence", "risk", "reversibility", "accountability"]},
    "actual_state": {"type": "object"},
    "expected_state": {"type": "object"},
    "forbidden_deltas": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "constraints": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "decision": {"type": ["string", "null"]},
    "decision_reason": {"type": ["string", "null"]},
    "authorization_ref": {"type": ["string", "null"]},
    "execution_ref": {"type": ["string", "null"]},
    "effect_ref": {"type": ["string", "null"]},
    "replay_ref": {"type": ["string", "null"]},
    "artifact_ref": {"type": ["string", "null"]},
    "metadata": {"type": "object"}
  }
}
