{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LS Identity Profile Patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "patch_id", "proposal_id", "proposal_digest", "approval_id", "agent_id", "base_profile_ref", "base_profile_version", "changes", "created_at", "created_by", "metadata"],
  "properties": {
    "schema_version": {"const": "trusted_runtime.identity_profile_patch.v0.1"},
    "patch_id": {"type": "string", "minLength": 1},
    "proposal_id": {"type": "string", "minLength": 1},
    "proposal_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "base_profile_ref": {"type": "string", "minLength": 1},
    "base_profile_version": {"type": "integer", "minimum": 1},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "key", "value"],
        "properties": {
          "operation": {"enum": ["SET", "REMOVE"]},
          "key": {"type": "string", "minLength": 1},
          "value": {}
        }
      }
    },
    "created_at": {"type": "string", "minLength": 1},
    "created_by": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"}
  }
}
