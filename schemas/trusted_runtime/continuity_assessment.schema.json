{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/LS/schemas/trusted_runtime/continuity_assessment.schema.json",
  "title": "LS Continuity Assessment v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "observation_id",
    "observation_digest",
    "subject_id",
    "track",
    "entity_status",
    "knowledge_class",
    "decision",
    "reason_codes",
    "normalized_statement",
    "preserved_influence",
    "lesson_candidate",
    "source_refs",
    "stable_identity_update_allowed",
    "execution_authorized",
    "policy_version",
    "assessed_at",
    "assessed_by",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "trusted_runtime.continuity_assessment.v0.1"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^continuity-assessment:sha256:[0-9a-f]{64}$"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "observation_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "type": "string",
      "minLength": 1
    },
    "entity_status": {
      "enum": [
        "ACTIVE",
        "PAUSED",
        "DECEASED",
        "CLOSED",
        "DELETED",
        "UNKNOWN"
      ]
    },
    "knowledge_class": {
      "enum": [
        "FACT",
        "MEMORY",
        "INFERENCE",
        "SYMBOLIC_MEANING"
      ]
    },
    "decision": {
      "enum": [
        "ACCEPT_BOUNDED_OBSERVATION",
        "HOLD_FOR_REVIEW",
        "BLOCK_FALSE_PRESENCE"
      ]
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "enum": [
          "VERIFIED_CURRENT_CLAIM",
          "UNVERIFIED_CURRENT_CLAIM",
          "FALSE_CURRENT_PRESENCE",
          "FALSE_CURRENT_INTENTION",
          "ENTITY_STATUS_UNKNOWN",
          "ENTITY_TEMPORARILY_INACTIVE",
          "HISTORICAL_INFLUENCE_PRESERVED",
          "BOUNDED_LESSON_ONLY",
          "NO_IDENTITY_CANDIDATE"
        ]
      }
    },
    "normalized_statement": {
      "type": "string",
      "minLength": 1
    },
    "preserved_influence": {
      "type": [
        "string",
        "null"
      ]
    },
    "lesson_candidate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statement",
            "scope",
            "confidence",
            "repeat_key",
            "evidence_refs"
          ],
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "repeat_key": {
              "type": "string",
              "minLength": 1
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "stable_identity_update_allowed": {
      "const": false
    },
    "execution_authorized": {
      "const": false
    },
    "policy_version": {
      "const": "continuity_coordinator.v0.1"
    },
    "assessed_at": {
      "type": "string",
      "minLength": 1
    },
    "assessed_by": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    }
  }
}
