{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LS Trusted Runtime Execution Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "task_id",
    "trail_id",
    "action_id",
    "action_ref",
    "action_digest",
    "authorization_ref",
    "authorization_nonce",
    "state",
    "decision_code",
    "actor",
    "created_at",
    "updated_at",
    "committed_at",
    "executed_at",
    "effect_ref",
    "effect_attempted",
    "effect_succeeded",
    "transitions",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "trusted_runtime.execution_record.v0.1"},
    "execution_id": {"type": "string", "pattern": "^execution:sha256:[0-9a-f]{64}$"},
    "task_id": {"type": "string", "minLength": 1},
    "trail_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "action_ref": {"type": "string", "minLength": 1},
    "action_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_ref": {"type": "string", "minLength": 1},
    "authorization_nonce": {"type": "string", "minLength": 1},
    "state": {
      "enum": [
        "RECEIVED",
        "VALIDATING",
        "HELD",
        "ACCEPTED",
        "COMMITTED",
        "EXECUTED",
        "REJECTED",
        "EXPIRED"
      ]
    },
    "decision_code": {"$ref": "#/$defs/decisionCode"},
    "actor": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "committed_at": {"type": ["string", "null"], "format": "date-time"},
    "executed_at": {"type": ["string", "null"], "format": "date-time"},
    "effect_ref": {"type": ["string", "null"]},
    "effect_attempted": {"type": "boolean"},
    "effect_succeeded": {"type": ["boolean", "null"]},
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/transition"}
    },
    "error": {"type": ["string", "null"]}
  },
  "$defs": {
    "decisionCode": {
      "enum": [
        "PERMIT_OK",
        "REJECT_INVALID_CAUSE",
        "REJECT_POLICY",
        "REJECT_CAPACITY_LIMIT",
        "REJECT_CAUSAL_ORDER",
        "REJECT_STATE_CONFLICT",
        "DEFER_PENDING_CONTEXT",
        "TTL_EXPIRED",
        "ABORT_INTERNAL_ERROR",
        "COMMIT_EXECUTED",
        "COMMIT_NO_EFFECT"
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "state",
        "event_type",
        "decision_code",
        "created_at",
        "actor",
        "detail",
        "effect_attempted"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "state": {
          "enum": [
            "RECEIVED",
            "VALIDATING",
            "HELD",
            "ACCEPTED",
            "COMMITTED",
            "EXECUTED",
            "REJECTED",
            "EXPIRED"
          ]
        },
        "event_type": {
          "enum": [
            "cause.received",
            "gate.validating",
            "gate.accept",
            "gate.hold",
            "gate.reject",
            "incubator.release",
            "incubator.expire",
            "commit.ok",
            "commit.fail",
            "execute.ok",
            "execute.fail"
          ]
        },
        "decision_code": {"$ref": "#/$defs/decisionCode"},
        "created_at": {"type": "string", "format": "date-time"},
        "actor": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1},
        "effect_attempted": {"type": "boolean"}
      }
    }
  }
}
