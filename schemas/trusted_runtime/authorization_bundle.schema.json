{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LS Trusted Runtime Authorization Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "task_id",
    "trail_id",
    "adapter",
    "actor",
    "created_at",
    "intent_ref",
    "decision_ref",
    "authorization_ref",
    "policy_version",
    "nonce",
    "scope",
    "evidence_refs",
    "causal_audit_refs",
    "chain_head",
    "file_hashes",
    "verification_instructions",
    "file_names"
  ],
  "properties": {
    "schema_version": {"const": "trusted_runtime.authorization_bundle.v0.1"},
    "bundle_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "trail_id": {"type": "string", "minLength": 1},
    "adapter": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "intent_ref": {"type": "string", "minLength": 1},
    "decision_ref": {"type": "string", "pattern": "^decision:sha256:[0-9a-f]{64}$"},
    "authorization_ref": {"type": "string", "pattern": "^authorization-record:sha256:[0-9a-f]{64}$"},
    "policy_version": {"type": "string", "minLength": 1},
    "nonce": {"type": "string", "minLength": 1},
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "causal_audit_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "chain_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_hashes": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "verification_instructions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "file_names": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
