    "processed_by":{"type":"string"},
    "metadata":{"type":"object","required":["supported_routes","route_matching","free_text_route_inference","router_output_is_not_authority"],"properties":{"supported_routes":{"const":["relationships.loss","projects.lifecycle","values.evidence","errors.learning","goals.commitments","capabilities.constraints"]},"route_matching":{"const":"exact_only"},"free_text_route_inference":{"const":false},"router_output_is_not_authority":{"const":true}},"additionalProperties":true}
