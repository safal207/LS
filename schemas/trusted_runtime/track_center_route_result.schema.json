    "reason_codes":{"type":"array","minItems":1,"uniqueItems":true},
    "routed_result":{"type":["object","null"]},
    "diagnostic_code":{"type":["string","null"],"enum":["unknown_track_center_route","relationship_loss_payload_invalid","project_payload_invalid","value_payload_invalid","error_learning_payload_invalid","goal_commitment_payload_invalid","capability_constraint_payload_invalid",null]},
    "relational_self_mutation_allowed":{"const":false},
    "project_registry_mutation_allowed":{"const":false},
    "task_scheduling_allowed":{"const":false},
    "value_registry_mutation_allowed":{"const":false},
    "priority_mutation_allowed":{"const":false},
    "incident_registry_mutation_allowed":{"const":false},
    "blame_assignment_allowed":{"const":false},
    "remediation_scheduling_allowed":{"const":false},
    "goal_registry_mutation_allowed":{"const":false},
    "obligation_assignment_allowed":{"const":false},
    "work_scheduling_allowed":{"const":false},
    "capability_registry_mutation_allowed":{"const":false},
    "capability_restriction_allowed":{"const":false},
    "global_limitation_assignment_allowed":{"const":false},
    "training_scheduling_allowed":{"const":false},
    "stable_identity_update_allowed":{"const":false},
