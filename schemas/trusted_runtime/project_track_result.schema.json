{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/LS/schemas/trusted_runtime/project_track_result.schema.json",
  "title": "LS Projects Track Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "event",
    "observation",
    "assessment",
    "project_registry_mutation_allowed",
    "task_scheduling_allowed",
    "stable_identity_update_allowed",
    "execution_authorized",
    "policy_version",
    "processed_at",
    "processed_by",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": "trusted_runtime.project_track_result.v0.1"},
    "result_id": {
      "type": "string",
      "pattern": "^project-track-result:sha256:[0-9a-f]{64}$"
    },
    "event": {"$ref": "#/$defs/projectEvent"},
    "observation": {"$ref": "#/$defs/projectObservation"},
    "assessment": {"$ref": "#/$defs/continuityAssessment"},
    "project_registry_mutation_allowed": {"const": false},
    "task_scheduling_allowed": {"const": false},
    "stable_identity_update_allowed": {"const": false},
    "execution_authorized": {"const": false},
    "policy_version": {"const": "projects_track_center.v0.1"},
    "processed_at": {"type": "string", "minLength": 1},
    "processed_by": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "projectEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "project_id",
        "event_type",
        "project_status",
        "previous_status",
        "knowledge_class",
        "statement",
        "occurred_at",
        "confidence",
        "evidence_refs",
        "identity_candidate_statement",
        "identity_scope",
        "identity_repeat_key",
        "metadata"
      ],
      "properties": {
        "schema_version": {"const": "trusted_runtime.project_event.v0.1"},
        "event_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "event_type": {
          "enum": [
            "PROJECT_STARTED",
            "PROJECT_PAUSED",
            "PROJECT_RESUMED",
            "PROJECT_COMPLETED",
            "PROJECT_CANCELLED",
            "PROJECT_ARCHIVED",
            "PROJECT_LESSON_RETAINED",
            "CURRENT_TASK_CLAIM",
            "CURRENT_PRIORITY_CLAIM"
          ]
        },
        "project_status": {
          "enum": ["ACTIVE", "PAUSED", "COMPLETED", "CANCELLED", "ARCHIVED", "UNKNOWN"]
        },
        "previous_status": {
          "type": ["string", "null"],
          "enum": ["ACTIVE", "PAUSED", "COMPLETED", "CANCELLED", "ARCHIVED", "UNKNOWN", null]
        },
        "knowledge_class": {
          "enum": ["FACT", "MEMORY", "INFERENCE", "SYMBOLIC_MEANING"]
        },
        "statement": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "identity_candidate_statement": {"$ref": "#/$defs/nullableString"},
        "identity_scope": {"$ref": "#/$defs/nullableString"},
        "identity_repeat_key": {"$ref": "#/$defs/nullableString"},
        "metadata": {"type": "object"}
      }
    },
    "projectObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "track",
        "subject_id",
        "entity_status",
        "knowledge_class",
        "statement",
        "occurred_at",
        "confidence",
        "evidence_refs",
        "claims_current_presence",
        "claims_current_intention",
        "identity_candidate_statement",
        "identity_scope",
        "identity_repeat_key",
        "metadata"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^project-observation:sha256:[0-9a-f]{64}$"
        },
        "track": {"const": "projects.lifecycle"},
        "subject_id": {"type": "string", "minLength": 1},
        "entity_status": {
          "enum": ["ACTIVE", "PAUSED", "CLOSED", "UNKNOWN"]
        },
        "knowledge_class": {
          "enum": ["FACT", "MEMORY", "INFERENCE", "SYMBOLIC_MEANING"]
        },
        "statement": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "claims_current_presence": {"const": false},
        "claims_current_intention": {"type": "boolean"},
        "identity_candidate_statement": {"$ref": "#/$defs/nullableString"},
        "identity_scope": {"$ref": "#/$defs/nullableString"},
        "identity_repeat_key": {"$ref": "#/$defs/nullableString"},
        "metadata": {
          "type": "object",
          "required": [
            "project_id",
            "project_event_id",
            "project_event_digest",
            "project_event_type",
            "project_status",
            "previous_status",
            "track_center_policy_version",
            "project_registry_mutation_allowed",
            "task_scheduling_allowed"
          ],
          "properties": {
            "project_registry_mutation_allowed": {"const": false},
            "task_scheduling_allowed": {"const": false}
          },
          "additionalProperties": true
        }
      }
    },
    "continuityAssessment": {
      "type": "object",
      "required": [
        "schema_version",
        "assessment_id",
        "observation_id",
        "entity_status",
        "decision",
        "reason_codes",
        "stable_identity_update_allowed",
        "execution_authorized"
      ],
      "properties": {
        "schema_version": {"const": "trusted_runtime.continuity_assessment.v0.1"},
        "assessment_id": {
          "type": "string",
          "pattern": "^continuity-assessment:sha256:[0-9a-f]{64}$"
        },
        "observation_id": {
          "type": "string",
          "pattern": "^project-observation:sha256:[0-9a-f]{64}$"
        },
        "entity_status": {
          "enum": ["ACTIVE", "PAUSED", "CLOSED", "UNKNOWN"]
        },
        "decision": {
          "enum": [
            "ACCEPT_BOUNDED_OBSERVATION",
            "HOLD_FOR_REVIEW",
            "BLOCK_FALSE_PRESENCE"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "stable_identity_update_allowed": {"const": false},
        "execution_authorized": {"const": false}
      },
      "additionalProperties": true
    }
  }
}
