{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/safal207/LS/schemas/trusted_runtime/authorization_result.schema.json",
  "title":"LS Authorization Result v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","decision_id","request_id","request_digest","decision","reason_codes","action_authorized","capability_registry_mutation_allowed","role_registry_mutation_allowed","permission_registry_mutation_allowed","approval_mutation_allowed","policy_mutation_allowed","context_mutation_allowed","work_scheduling_allowed","stable_identity_update_allowed","execution_authorized","policy_version","evaluated_at","evaluated_by","metadata"],
  "properties":{
    "schema_version":{"const":"trusted_runtime.authorization_result.v0.1"},
    "decision_id":{"type":"string","pattern":"^authorization-decision:sha256:[0-9a-f]{64}$"},
    "request_id":{"type":"string","minLength":1},
    "request_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "decision":{"enum":["ALLOW","BLOCK","ESCALATE"]},
    "reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "action_authorized":{"type":"boolean"},
    "capability_registry_mutation_allowed":{"const":false},
    "role_registry_mutation_allowed":{"const":false},
    "permission_registry_mutation_allowed":{"const":false},
    "approval_mutation_allowed":{"const":false},
    "policy_mutation_allowed":{"const":false},
    "context_mutation_allowed":{"const":false},
    "work_scheduling_allowed":{"const":false},
    "stable_identity_update_allowed":{"const":false},
    "execution_authorized":{"const":false},
    "policy_version":{"const":"authorization_decision_gate.v0.1"},
    "evaluated_at":{"type":"string","minLength":1},
    "evaluated_by":{"type":"string","minLength":1},
    "metadata":{"type":"object","required":["decision_precedence","decision_is_not_execution","capability_is_not_permission","permission_is_not_execution","role_membership_is_not_authority","approval_requirement_is_not_approval","evidence_binding"],"properties":{"decision_precedence":{"const":["BLOCK","ESCALATE","ALLOW"]},"decision_is_not_execution":{"const":true},"capability_is_not_permission":{"const":true},"permission_is_not_execution":{"const":true},"role_membership_is_not_authority":{"const":true},"approval_requirement_is_not_approval":{"const":true},"evidence_binding":{"type":"object","required":["capability_result_digest","authority_result_digest","policy_digest","approval_digest","context_digest"]}},"additionalProperties":true}
  },
  "allOf":[
    {"if":{"properties":{"decision":{"const":"ALLOW"}}},"then":{"properties":{"action_authorized":{"const":true}}}},
    {"if":{"properties":{"decision":{"enum":["BLOCK","ESCALATE"]}}},"then":{"properties":{"action_authorized":{"const":false}}}}
  ]
}
