{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/LS/schemas/trusted_runtime/lesson_aggregation_v0.2.schema.json",
  "title": "LS Lesson Aggregation v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "aggregation_id",
    "scope",
    "repeat_key",
    "candidate_statement",
    "created_at",
    "status",
    "supporting_episode_refs",
    "failure_episode_refs",
    "contradicting_episode_refs",
    "ignored_episode_refs",
    "support_count",
    "failure_count",
    "contradiction_count",
    "ignored_count",
    "aggregated_confidence",
    "required_support_count",
    "proposal",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "trusted_runtime.lesson_aggregation.v0.2"
    },
    "aggregation_id": {
      "type": "string",
      "pattern": "^lesson-aggregation-v0\\.2:sha256:[0-9a-f]{64}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "repeat_key": {
      "type": "string",
      "minLength": 1
    },
    "candidate_statement": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "NO_ELIGIBLE_EPISODES",
        "INSUFFICIENT_SUPPORT",
        "CONFLICTED",
        "READY_FOR_REVIEW"
      ]
    },
    "supporting_episode_refs": {
      "$ref": "#/$defs/episodeRefs"
    },
    "failure_episode_refs": {
      "$ref": "#/$defs/episodeRefs"
    },
    "contradicting_episode_refs": {
      "$ref": "#/$defs/episodeRefs"
    },
    "ignored_episode_refs": {
      "$ref": "#/$defs/episodeRefs"
    },
    "support_count": {
      "type": "integer",
      "minimum": 0
    },
    "failure_count": {
      "type": "integer",
      "minimum": 0
    },
    "contradiction_count": {
      "type": "integer",
      "minimum": 0
    },
    "ignored_count": {
      "type": "integer",
      "minimum": 0
    },
    "aggregated_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "required_support_count": {
      "type": "integer",
      "minimum": 3
    },
    "proposal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        }
      ]
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "episodeRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
