{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LS Trusted Runtime Execution Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "task_id",
    "trail_id",
    "decision",
    "actor",
    "scope",
    "issued_at",
    "expires_at",
    "nonce",
    "evidence_refs",
    "policy_version",
    "parent_cause"
  ],
  "properties": {
    "schema_version": {"const": "trusted_runtime.execution_authorization.v0.1"},
    "authorization_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "trail_id": {"type": "string", "minLength": 1},
    "decision": {"const": "ALLOW"},
    "actor": {"type": "string", "minLength": 1},
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "policy_version": {"type": "string", "minLength": 1},
    "parent_cause": {"type": "string", "minLength": 1}
  }
}
