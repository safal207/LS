{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LS Trusted Runtime Replay Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "replay_id",
    "task_id",
    "trail_id",
    "actor",
    "created_at",
    "source_event_refs",
    "decision",
    "reason",
    "drift_refs",
    "parent_cause"
  ],
  "properties": {
    "schema_version": {"const": "trusted_runtime.replay_record.v0.1"},
    "replay_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "trail_id": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source_event_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decision": {"enum": ["ADMISSIBLE", "DRIFTED", "REJECTED"]},
    "reason": {"type": "string", "minLength": 1},
    "drift_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "parent_cause": {"type": "string", "minLength": 1}
  }
}
