{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/LS/schemas/trusted_runtime/relationship_loss_result.schema.json",
  "title": "LS Relationship/Loss Track Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "event",
    "observation",
    "assessment",
    "relational_self_mutation_allowed",
    "stable_identity_update_allowed",
    "execution_authorized",
    "policy_version",
    "processed_at",
    "processed_by",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "trusted_runtime.relationship_loss_result.v0.1"
    },
    "result_id": {
      "type": "string",
      "pattern": "^relationship-loss-result:sha256:[0-9a-f]{64}$"
    },
    "event": {
      "$ref": "#/$defs/relationshipEvent"
    },
    "observation": {
      "$ref": "#/$defs/trackObservation"
    },
    "assessment": {
      "$ref": "#/$defs/continuityAssessment"
    },
    "relational_self_mutation_allowed": {
      "const": false
    },
    "stable_identity_update_allowed": {
      "const": false
    },
    "execution_authorized": {
      "const": false
    },
    "policy_version": {
      "const": "relationship_loss_track_center.v0.1"
    },
    "processed_at": {
      "type": "string",
      "minLength": 1
    },
    "processed_by": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "identityCandidateFields": {
      "type": ["string", "null"]
    },
    "relationshipEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "relationship_id",
        "subject_id",
        "event_type",
        "entity_status",
        "knowledge_class",
        "statement",
        "occurred_at",
        "confidence",
        "evidence_refs",
        "identity_candidate_statement",
        "identity_scope",
        "identity_repeat_key",
        "metadata"
      ],
      "properties": {
        "schema_version": {
          "const": "trusted_runtime.relationship_loss_event.v0.1"
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "relationship_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "enum": [
            "INTERACTION_RECORDED",
            "RELATIONSHIP_CLOSED",
            "LOSS_CONFIRMED",
            "REMEMBERED_INFLUENCE",
            "CURRENT_PRESENCE_CLAIM",
            "CURRENT_INTENTION_CLAIM"
          ]
        },
        "entity_status": {
          "enum": ["ACTIVE", "DECEASED", "CLOSED", "DELETED", "UNKNOWN"]
        },
        "knowledge_class": {
          "enum": ["FACT", "MEMORY", "INFERENCE", "SYMBOLIC_MEANING"]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "occurred_at": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "identity_candidate_statement": {
          "$ref": "#/$defs/identityCandidateFields"
        },
        "identity_scope": {
          "$ref": "#/$defs/identityCandidateFields"
        },
        "identity_repeat_key": {
          "$ref": "#/$defs/identityCandidateFields"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "trackObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "track",
        "subject_id",
        "entity_status",
        "knowledge_class",
        "statement",
        "occurred_at",
        "confidence",
        "evidence_refs",
        "claims_current_presence",
        "claims_current_intention",
        "identity_candidate_statement",
        "identity_scope",
        "identity_repeat_key",
        "metadata"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^relationship-observation:sha256:[0-9a-f]{64}$"
        },
        "track": {
          "const": "relationships.loss"
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_status": {
          "enum": ["ACTIVE", "DECEASED", "CLOSED", "DELETED", "UNKNOWN"]
        },
        "knowledge_class": {
          "enum": ["FACT", "MEMORY", "INFERENCE", "SYMBOLIC_MEANING"]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "occurred_at": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claims_current_presence": {
          "type": "boolean"
        },
        "claims_current_intention": {
          "type": "boolean"
        },
        "identity_candidate_statement": {
          "$ref": "#/$defs/identityCandidateFields"
        },
        "identity_scope": {
          "$ref": "#/$defs/identityCandidateFields"
        },
        "identity_repeat_key": {
          "$ref": "#/$defs/identityCandidateFields"
        },
        "metadata": {
          "type": "object",
          "required": [
            "relationship_id",
            "relationship_event_id",
            "relationship_event_digest",
            "relationship_event_type",
            "track_center_policy_version",
            "relational_self_mutation_allowed"
          ],
          "properties": {
            "relational_self_mutation_allowed": {
              "const": false
            }
          },
          "additionalProperties": true
        }
      }
    },
    "continuityAssessment": {
      "type": "object",
      "required": [
        "schema_version",
        "assessment_id",
        "observation_id",
        "decision",
        "reason_codes",
        "stable_identity_update_allowed",
        "execution_authorized"
      ],
      "properties": {
        "schema_version": {
          "const": "trusted_runtime.continuity_assessment.v0.1"
        },
        "assessment_id": {
          "type": "string",
          "pattern": "^continuity-assessment:sha256:[0-9a-f]{64}$"
        },
        "observation_id": {
          "type": "string",
          "pattern": "^relationship-observation:sha256:[0-9a-f]{64}$"
        },
        "decision": {
          "enum": [
            "ACCEPT_BOUNDED_OBSERVATION",
            "HOLD_FOR_REVIEW",
            "BLOCK_FALSE_PRESENCE"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "stable_identity_update_allowed": {
          "const": false
        },
        "execution_authorized": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  }
}
