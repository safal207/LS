{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/LS/schemas/trusted_runtime/value_track_result.schema.json",
  "title": "LS Values Track Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "event",
    "observation",
    "assessment",
    "value_registry_mutation_allowed",
    "priority_mutation_allowed",
    "stable_identity_update_allowed",
    "execution_authorized",
    "policy_version",
    "processed_at",
    "processed_by",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": "trusted_runtime.value_track_result.v0.1"},
    "result_id": {
      "type": "string",
      "pattern": "^value-track-result:sha256:[0-9a-f]{64}$"
    },
    "event": {"$ref": "#/$defs/valueEvent"},
    "observation": {"$ref": "#/$defs/valueObservation"},
    "assessment": {"$ref": "#/$defs/continuityAssessment"},
    "value_registry_mutation_allowed": {"const": false},
    "priority_mutation_allowed": {"const": false},
    "stable_identity_update_allowed": {"const": false},
    "execution_authorized": {"const": false},
    "policy_version": {"const": "values_track_center.v0.1"},
    "processed_at": {"type": "string", "minLength": 1},
    "processed_by": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "stringRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "valueEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "value_key",
        "event_type",
        "value_status",
        "knowledge_class",
        "statement",
        "occurred_at",
        "confidence",
        "repeat_count",
        "evidence_refs",
        "context_refs",
        "identity_candidate_statement",
        "identity_scope",
        "identity_repeat_key",
        "metadata"
      ],
      "properties": {
        "schema_version": {"const": "trusted_runtime.value_event.v0.1"},
        "event_id": {"type": "string", "minLength": 1},
        "value_key": {"type": "string", "minLength": 1},
        "event_type": {
          "enum": [
            "VALUE_SIGNAL_OBSERVED",
            "VALUE_REAFFIRMED",
            "VALUE_PRACTICED",
            "VALUE_CONFLICT_RECORDED",
            "VALUE_RETIRED",
            "TRANSIENT_PREFERENCE_OBSERVED",
            "MOOD_SIGNAL_OBSERVED",
            "CURRENT_VALUE_CLAIM"
          ]
        },
        "value_status": {
          "enum": ["CANDIDATE", "ACTIVE", "CONTESTED", "RETIRED", "UNKNOWN"]
        },
        "knowledge_class": {
          "enum": ["FACT", "MEMORY", "INFERENCE", "SYMBOLIC_MEANING"]
        },
        "statement": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "repeat_count": {"type": "integer", "minimum": 1},
        "evidence_refs": {"$ref": "#/$defs/stringRefs"},
        "context_refs": {"$ref": "#/$defs/stringRefs"},
        "identity_candidate_statement": {"$ref": "#/$defs/nullableString"},
        "identity_scope": {"$ref": "#/$defs/nullableString"},
        "identity_repeat_key": {"$ref": "#/$defs/nullableString"},
        "metadata": {"type": "object"}
      }
    },
    "valueObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "track",
        "subject_id",
        "entity_status",
        "knowledge_class",
        "statement",
        "occurred_at",
        "confidence",
        "evidence_refs",
        "claims_current_presence",
        "claims_current_intention",
        "identity_candidate_statement",
        "identity_scope",
        "identity_repeat_key",
        "metadata"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^value-observation:sha256:[0-9a-f]{64}$"
        },
        "track": {"const": "values.evidence"},
        "subject_id": {"type": "string", "minLength": 1},
        "entity_status": {
          "enum": ["ACTIVE", "PAUSED", "CLOSED", "UNKNOWN"]
        },
        "knowledge_class": {
          "enum": ["FACT", "MEMORY", "INFERENCE", "SYMBOLIC_MEANING"]
        },
        "statement": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_refs": {"$ref": "#/$defs/stringRefs"},
        "claims_current_presence": {"const": false},
        "claims_current_intention": {"type": "boolean"},
        "identity_candidate_statement": {"$ref": "#/$defs/nullableString"},
        "identity_scope": {"$ref": "#/$defs/nullableString"},
        "identity_repeat_key": {"$ref": "#/$defs/nullableString"},
        "metadata": {
          "type": "object",
          "required": [
            "value_key",
            "value_event_id",
            "value_event_digest",
            "value_event_type",
            "value_status",
            "repeat_count",
            "context_refs",
            "track_center_policy_version",
            "value_registry_mutation_allowed",
            "priority_mutation_allowed"
          ],
          "properties": {
            "value_registry_mutation_allowed": {"const": false},
            "priority_mutation_allowed": {"const": false}
          },
          "additionalProperties": true
        }
      }
    },
    "continuityAssessment": {
      "type": "object",
      "required": [
        "schema_version",
        "assessment_id",
        "observation_id",
        "entity_status",
        "decision",
        "reason_codes",
        "stable_identity_update_allowed",
        "execution_authorized"
      ],
      "properties": {
        "schema_version": {"const": "trusted_runtime.continuity_assessment.v0.1"},
        "assessment_id": {
          "type": "string",
          "pattern": "^continuity-assessment:sha256:[0-9a-f]{64}$"
        },
        "observation_id": {
          "type": "string",
          "pattern": "^value-observation:sha256:[0-9a-f]{64}$"
        },
        "entity_status": {
          "enum": ["ACTIVE", "PAUSED", "CLOSED", "UNKNOWN"]
        },
        "decision": {
          "enum": [
            "ACCEPT_BOUNDED_OBSERVATION",
            "HOLD_FOR_REVIEW",
            "BLOCK_FALSE_PRESENCE"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "stable_identity_update_allowed": {"const": false},
        "execution_authorized": {"const": false}
      },
      "additionalProperties": true
    }
  }
}
