{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LS Durable Event v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trail_id",
    "event_id",
    "sequence",
    "event_type",
    "created_at",
    "parent_event_id",
    "source_payload_digest",
    "payload_digest",
    "payload",
    "previous_event_digest",
    "event_digest"
  ],
  "properties": {
    "schema_version": {"const": "ls.durable_event.v0.1"},
    "trail_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "event_type": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "parent_event_id": {"type": ["string", "null"]},
    "source_payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "payload": {"type": "object"},
    "previous_event_digest": {"type": ["string", "null"]},
    "event_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
