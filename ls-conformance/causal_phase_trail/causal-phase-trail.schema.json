{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/LS/ls-conformance/causal_phase_trail/causal-phase-trail.schema.json",
  "title": "LS Causal Phase Trail V0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "trailId",
    "authority",
    "observedAt",
    "subject",
    "spaces",
    "nodes",
    "edges",
    "phaseHistory",
    "routes",
    "decision"
  ],
  "properties": {
    "schemaVersion": {"const": "ls.causal-phase-trail.v0"},
    "trailId": {"type": "string", "pattern": "^CPT-[A-Z0-9-]{3,80}$"},
    "authority": {"const": "EVIDENCE_ONLY"},
    "observedAt": {"type": "string", "format": "date-time"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullRequest", "baseHead", "currentHead"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "pullRequest": {"type": "integer", "minimum": 1},
        "baseHead": {"$ref": "#/$defs/sha"},
        "currentHead": {"$ref": "#/$defs/sha"}
      }
    },
    "spaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "value"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {
            "enum": [
              "REPOSITORY",
              "PULL_REQUEST",
              "ARTIFACT",
              "COMPONENT",
              "SURFACE",
              "VIEWPORT",
              "BROWSER_CAPABILITY",
              "AGENT",
              "GATE",
              "EVIDENCE"
            ]
          },
          "value": {"type": "string", "minLength": 1}
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "eventTime",
          "observedAt",
          "validFromHead",
          "validUntilHead",
          "spaceRefs",
          "agent",
          "claimRole",
          "evidenceStatus",
          "blocking",
          "binding",
          "source"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {
            "enum": [
              "EVENT",
              "STATE",
              "EVIDENCE",
              "CAUSE",
              "PHASE_TRANSITION",
              "DECISION",
              "ROUTE",
              "OUTCOME"
            ]
          },
          "label": {"type": "string", "minLength": 1},
          "eventTime": {"type": "string", "format": "date-time"},
          "observedAt": {"type": "string", "format": "date-time"},
          "validFromHead": {"$ref": "#/$defs/sha"},
          "validUntilHead": {
            "oneOf": [
              {"$ref": "#/$defs/sha"},
              {"type": "null"}
            ]
          },
          "spaceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/id"},
            "uniqueItems": true
          },
          "agent": {"type": ["string", "null"]},
          "claimRole": {
            "enum": [
              "DETECTOR",
              "IMMEDIATE_CAUSE",
              "ROOT_CAUSE",
              "AMPLIFYING_CONDITION",
              "CORRECTIVE_ACTION",
              "OTHER"
            ]
          },
          "evidenceStatus": {"enum": ["FRESH", "STALE", "NOT_APPLICABLE"]},
          "blocking": {"type": "boolean"},
          "binding": {"type": "boolean"},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "relation", "binding", "explanation"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "from": {"$ref": "#/$defs/id"},
          "to": {"$ref": "#/$defs/id"},
          "relation": {
            "enum": [
              "PRECEDED",
              "CAUSED",
              "DETECTED",
              "BLOCKED",
              "RESOLVED",
              "INVALIDATED",
              "CONFIRMED",
              "ENABLED",
              "REJECTED"
            ]
          },
          "binding": {"type": "boolean"},
          "explanation": {"type": "string", "minLength": 1}
        }
      }
    },
    "phaseHistory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "enteredAt", "triggerNodeId", "transitionKind", "guards"],
        "properties": {
          "phase": {"$ref": "#/$defs/phase"},
          "enteredAt": {"type": "string", "format": "date-time"},
          "triggerNodeId": {"$ref": "#/$defs/id"},
          "transitionKind": {"enum": ["FORWARD", "REGRESSION"]},
          "guards": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "satisfied", "evidenceNodeIds"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "satisfied": {"type": "boolean"},
                "evidenceNodeIds": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/id"},
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "routeId",
          "title",
          "selected",
          "components",
          "score",
          "explanation",
          "rejectedReason"
        ],
        "properties": {
          "routeId": {"$ref": "#/$defs/id"},
          "title": {"type": "string", "minLength": 1},
          "selected": {"type": "boolean"},
          "components": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "riskReduction",
              "evidenceConfidence",
              "reversibility",
              "implementationCost",
              "scopeExpansion",
              "staleEvidenceCost"
            ],
            "properties": {
              "riskReduction": {"$ref": "#/$defs/componentScore"},
              "evidenceConfidence": {"$ref": "#/$defs/componentScore"},
              "reversibility": {"$ref": "#/$defs/componentScore"},
              "implementationCost": {"$ref": "#/$defs/componentScore"},
              "scopeExpansion": {"$ref": "#/$defs/componentScore"},
              "staleEvidenceCost": {"$ref": "#/$defs/componentScore"}
            }
          },
          "score": {"type": "integer", "minimum": -15, "maximum": 15},
          "explanation": {"type": "string", "minLength": 1},
          "rejectedReason": {"type": ["string", "null"]}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentPhase",
        "bestRouteId",
        "rootCauseNodeId",
        "detectorNodeIds",
        "unresolvedBlockerNodeIds",
        "nextLegalTransitions",
        "summary"
      ],
      "properties": {
        "currentPhase": {"$ref": "#/$defs/phase"},
        "bestRouteId": {"$ref": "#/$defs/id"},
        "rootCauseNodeId": {"$ref": "#/$defs/id"},
        "detectorNodeIds": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "unresolvedBlockerNodeIds": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "nextLegalTransitions": {
          "type": "array",
          "items": {"$ref": "#/$defs/phase"},
          "uniqueItems": true
        },
        "summary": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,79}$"},
    "componentScore": {"type": "integer", "minimum": 0, "maximum": 5},
    "phase": {
      "enum": [
        "IDEA",
        "CANDIDATE",
        "UNSTABLE",
        "UNDER_REVIEW",
        "RISK_DISCOVERED",
        "CORRECTED",
        "EVIDENCE_ACCUMULATING",
        "STABLE",
        "MERGE_READY",
        "MERGED"
      ]
    }
  }
}
