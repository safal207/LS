{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/LS/fixtures/trusted-runtime/durable-approval/event.schema.json",
  "title": "LS Approval Lifecycle Event v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "approval_id",
    "sequence",
    "event_type",
    "occurred_at",
    "actor"
  ],
  "properties": {
    "schema_version": {"const": "ls-approval-lifecycle-event-v0.1"},
    "event_id": {"type": "string", "minLength": 1},
    "approval_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "event_type": {
      "enum": [
        "ApprovalRequested",
        "ApprovalPresented",
        "RequesterDetached",
        "RequesterCancelled",
        "TransportDisconnected",
        "TransportRestored",
        "UiDismissed",
        "WaitWindowElapsed",
        "UserApproved",
        "UserRejected",
        "ApprovalExpired",
        "ApprovalInvalidated",
        "ExecutionClaimed",
        "EffectObserved",
        "RuntimeRestarted",
        "LostStateDetected"
      ]
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "actor": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["USER", "REVIEWER", "AGENT", "RUNTIME", "TRANSPORT", "POLICY", "VERIFIER", "SYSTEM"]},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "reason": {"type": ["string", "null"]},
    "evidence_ref": {"type": ["string", "null"]},
    "bindings": {
      "type": "object",
      "required": ["action_digest", "scope_digest", "policy_digest", "workspace_identity", "target_state_digest"],
      "properties": {
        "action_digest": {"type": "string", "pattern": "^sha256:[A-Za-z0-9._-]+$"},
        "scope_digest": {"type": "string", "pattern": "^sha256:[A-Za-z0-9._-]+$"},
        "policy_digest": {"type": "string", "pattern": "^sha256:[A-Za-z0-9._-]+$"},
        "workspace_identity": {"type": "string", "minLength": 1},
        "target_state_digest": {"type": "string", "pattern": "^sha256:[A-Za-z0-9._-]+$"}
      },
      "additionalProperties": false
    },
    "outcome": {"enum": ["COMMITTED", "FAILED"]}
  },
  "allOf": [
    {
      "if": {"properties": {"event_type": {"enum": ["UserApproved", "UserRejected", "ApprovalExpired", "ApprovalInvalidated", "LostStateDetected"]}}},
      "then": {"required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"event_type": {"enum": ["ApprovalExpired", "ApprovalInvalidated", "EffectObserved", "LostStateDetected"]}}},
      "then": {"required": ["evidence_ref"], "properties": {"evidence_ref": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "ExecutionClaimed"}}},
      "then": {"required": ["bindings"]}
    },
    {
      "if": {"properties": {"event_type": {"const": "EffectObserved"}}},
      "then": {"required": ["outcome"]}
    }
  ],
  "additionalProperties": false
}
