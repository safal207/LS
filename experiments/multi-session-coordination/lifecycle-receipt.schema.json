{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/LS/experiments/multi-session-coordination/lifecycle-receipt.schema.json",
  "title": "LS Lifecycle Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "producer_session",
    "transition",
    "generation",
    "previous_state_hash",
    "new_state_hash",
    "affected_sessions",
    "dependency_id",
    "verification"
  ],
  "properties": {
    "schema": {"const": "ls.multi-session.lifecycle-receipt.v0.1"},
    "event_id": {"type": "string", "minLength": 1},
    "producer_session": {"type": "string", "minLength": 1},
    "transition": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 0},
    "previous_state_hash": {"type": "string", "minLength": 1},
    "new_state_hash": {"type": "string", "minLength": 1},
    "affected_sessions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dependency_id": {"type": "string", "minLength": 1},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["VERIFIED", "FAILED", "NOT_RUN"]},
        "verifier": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "VERIFIED"}}},
          "then": {"required": ["verifier", "evidence_ref"]}
        }
      ]
    }
  }
}
