{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vtl/use-time-conformance-v0.4.schema.json",
  "title": "Verified Transition Loop Use-Time Conformance v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "base", "cases"],
  "properties": {
    "schema_version": {"const": "vtl.use-time-conformance/v0.4"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "receipt_ids",
        "reason_code_order",
        "comparison_rule",
        "authorization_is_execution_authority",
        "execute_receipt_single_use"
      ],
      "properties": {
        "profile_id": {"const": "vtl-use-time-v0.4"},
        "receipt_ids": {"const": "implementation-local"},
        "reason_code_order": {"enum": ["normative", "non-normative"]},
        "comparison_rule": {"type": "string", "minLength": 1},
        "authorization_is_execution_authority": {"const": false},
        "execute_receipt_single_use": {"const": true}
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "proposal",
        "authorization_evidence",
        "authorization_verifier_id",
        "executor_id",
        "authorized_at_ms"
      ],
      "properties": {
        "intent": {"$ref": "#/$defs/intent"},
        "proposal": {"$ref": "#/$defs/proposal"},
        "authorization_evidence": {"$ref": "#/$defs/evidence"},
        "authorization_verifier_id": {"type": "string", "minLength": 1},
        "executor_id": {"type": "string", "minLength": 1},
        "authorized_at_ms": {"type": "integer", "minimum": 0}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_id", "actor", "action", "purpose"],
      "properties": {
        "intent_id": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "intent_id",
        "pre_state",
        "action",
        "expected_post_state",
        "invariants"
      ],
      "properties": {
        "transition_id": {"type": "string", "minLength": 1},
        "intent_id": {"type": "string", "minLength": 1},
        "pre_state": {"type": "string"},
        "action": {"type": "string", "minLength": 1},
        "expected_post_state": {"type": "string"},
        "invariants": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_aligned",
        "exact_source_bound",
        "tests_passed",
        "approval_current",
        "approval_valid_until_ms",
        "evidence_refs",
        "source_ref",
        "policy_ref",
        "approval_ref"
      ],
      "properties": {
        "mission_aligned": {"type": ["boolean", "null"]},
        "exact_source_bound": {"type": ["boolean", "null"]},
        "tests_passed": {"type": ["boolean", "null"]},
        "approval_current": {"type": ["boolean", "null"]},
        "approval_valid_until_ms": {"type": ["integer", "null"], "minimum": 0},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "source_ref": {"type": ["string", "null"]},
        "policy_ref": {"type": ["string", "null"]},
        "approval_ref": {"type": ["string", "null"]}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "current_evidence",
        "executor_id",
        "checked_at_ms",
        "execution_nonce",
        "expected"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "current_evidence": {"$ref": "#/$defs/evidence"},
        "executor_id": {"type": "string", "minLength": 1},
        "checked_at_ms": {"type": "integer", "minimum": 0},
        "execution_nonce": {"type": "string"},
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "reason_codes", "consume_results"],
          "properties": {
            "verdict": {"enum": ["EXECUTE", "HOLD", "BLOCK"]},
            "reason_codes": {"type": "array", "items": {"type": "string"}},
            "consume_results": {
              "type": "array",
              "items": {"type": "boolean"},
              "minItems": 1
            }
          }
        }
      }
    }
  }
}
