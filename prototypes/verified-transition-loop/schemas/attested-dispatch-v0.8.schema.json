{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vtl/attested-dispatch-v0.8.schema.json",
  "title": "VTL v0.8 Attested Dispatch Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "schema_version", "transcript", "attestation"],
  "properties": {
    "profile_id": {"const": "vtl-attested-dispatch-v0.8"},
    "schema_version": {"const": "vtl.attested-dispatch/v0.8"},
    "transcript": {"type": "object"},
    "attestation": {"$ref": "#/$defs/attestation"}
  },
  "$defs": {
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_id", "profile_id", "schema_version", "transcript_digest",
        "issuer_id", "signer_key_id", "trust_root_id", "issued_at_ms",
        "not_before_ms", "not_after_ms", "trust_policy_version",
        "signature_algorithm", "signature"
      ],
      "properties": {
        "attestation_id": {"type": "string", "minLength": 1},
        "profile_id": {"const": "vtl-attested-dispatch-v0.8"},
        "schema_version": {"const": "vtl.attested-dispatch/v0.8"},
        "transcript_digest": {"$ref": "#/$defs/hex64"},
        "issuer_id": {"type": "string", "minLength": 1},
        "signer_key_id": {"type": "string", "minLength": 1},
        "trust_root_id": {"type": "string", "minLength": 1},
        "issued_at_ms": {"type": "integer", "minimum": 0},
        "not_before_ms": {"type": "integer", "minimum": 0},
        "not_after_ms": {"type": "integer", "minimum": 0},
        "trust_policy_version": {"type": "string", "minLength": 1},
        "signature_algorithm": {"const": "ED25519"},
        "signature": {"type": "string", "minLength": 1}
      }
    },
    "trust_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "trust_root_id", "policy_version", "allowed_algorithms", "keys"],
      "properties": {
        "profile_id": {"const": "vtl-trust-root/v0.8"},
        "trust_root_id": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "allowed_algorithms": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "signer_key_id", "issuer_id", "algorithm", "public_key_base64",
              "not_before_ms", "not_after_ms", "revoked"
            ],
            "properties": {
              "signer_key_id": {"type": "string", "minLength": 1},
              "issuer_id": {"type": "string", "minLength": 1},
              "algorithm": {"const": "ED25519"},
              "public_key_base64": {"type": "string", "minLength": 1},
              "not_before_ms": {"type": "integer", "minimum": 0},
              "not_after_ms": {"type": "integer", "minimum": 0},
              "revoked": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
