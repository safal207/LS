{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vtl/canonical-proof-v0.10.schema.json",
  "title": "VTL Cross-Language Canonical Proof v0.10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "schema_version",
    "canonical_profile",
    "cases",
    "negative_cases",
    "mutation_cases"
  ],
  "properties": {
    "profile_id": {"const": "vtl-canonical-proof-v0.10"},
    "schema_version": {"const": "vtl.canonical-proof/v0.10"},
    "canonical_profile": {"const": "rfc8785-safe-integer/v0.10"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "raw_json", "canonical_utf8_base64", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "raw_json": {"type": "string"},
          "canonical_utf8_base64": {
            "type": "string",
            "minLength": 4,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "negative_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "raw_json", "error_code"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "raw_json": {"type": "string"},
          "error_code": {
            "enum": [
              "UNSUPPORTED_NUMBER",
              "INTEGER_OUT_OF_RANGE",
              "DUPLICATE_KEY",
              "INVALID_UNICODE_SCALAR",
              "INVALID_JSON"
            ]
          }
        }
      }
    },
    "mutation_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "base_raw_json",
          "mutated_raw_json",
          "base_sha256",
          "mutated_sha256",
          "digests_differ"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "base_raw_json": {"type": "string"},
          "mutated_raw_json": {"type": "string"},
          "base_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "mutated_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "digests_differ": {"const": true}
        }
      }
    }
  }
}
